# Copia este fichero a .env.local y rellena los valores del proyecto de Supabase.
# Panel de Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo si se usa Google Calendar (importar horas desde el calendario). Mismas
# credenciales OAuth que las de Supabase (Authentication > Sign In / Providers
# > Google), pero hacen falta aqui tambien porque el canje del token de
# Calendar lo hace el propio servidor de la app, no Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# La direccion publica de la aplicacion. Supabase tiene ademas la suya en su
# panel (Authentication > URL Configuration, ver DESPLIEGUE.md), pero esta hace
# falta aqui porque es la que usa el Checkout de Stripe para saber a donde
# devolverte al pagar o al cancelar. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cifra el `refresh_token` de Google Calendar antes de guardarlo en la base
# (AES-256-GCM, ver src/lib/cifrado.ts). 32 bytes en base64: se genera con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tiene que ser la MISMA cadena en local y en Vercel: si cambia, los tokens ya
# guardados dejan de poder descifrarse y hay que volver a conectar el
# calendario. Nunca debe llegar al navegador.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Stripe
# El cobro. Todo esto es de servidor y no lleva NEXT_PUBLIC_ a proposito: la
# clave secreta no puede acabar en el paquete que baja el navegador.
#
# OJO: el modo de pruebas (sandbox) y el modo real son DOS CUENTAS DISTINTAS,
# con sus propios productos, precios, tipos de IVA y secretos de webhook. Nada
# de lo del sandbox vale en produccion; hay que crearlo otra vez alli.

# Panel de Stripe > Desarrolladores > Claves de API. Empieza por sk_test_ en
# el sandbox y por sk_live_ en el modo real.
STRIPE_SECRET_KEY=

# El precio recurrente de 19 EUR/mes, SIN impuestos. Se crea en Productos.
STRIPE_PRICE_ID=price_...

# El tipo de IVA del 21%, creado en Productos > Tipos de impuesto. El precio
# va sin IVA y este se suma como linea aparte (19 + 3,99 = 22,99 EUR).
STRIPE_TAX_RATE_ID=txr_...

# El secreto de firma del endpoint, en Desarrolladores > Webhooks. NO es el
# que imprime `stripe listen`: son distintos, y con el que no toca el webhook
# rechaza todo con "Firma invalida". El endpoint de produccion es
#   https://www.hitoo.es/api/stripe/webhook
# y escucha checkout.session.completed y customer.subscription.*
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------- Supabase (2)
# La clave de servicio, solo para el webhook de Stripe: la tabla
# `workspace_subscriptions` no tiene politica de escritura para nadie -ni para
# el propio equipo-, asi que esta es la unica mano que la toca. Panel de
# Supabase > Project Settings > API. Nunca debe llegar al navegador.
#
# (Para Google Calendar NO hace falta: el token se guarda cifrado, asi que el
# SELECT que el rol `authenticated` tiene sobre esa columna devuelve texto
# cifrado y no sirve de nada. Ver ROADMAP.md, revision del 21-ago-2026.)
SUPABASE_SERVICE_ROLE_KEY=
