# Copia este fichero a .env.local y rellena los valores del proyecto de Supabase.
# Panel de Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo si se usa Google Calendar (importar horas desde el calendario). Mismas
# credenciales OAuth que las de Supabase (Authentication > Sign In / Providers
# > Google), pero hacen falta aqui tambien porque el canje del token de
# Calendar lo hace el propio servidor de la app, no Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# La direccion publica de la aplicacion se configura en el panel de Supabase
# (Authentication > URL Configuration), no aqui: mirar DESPLIEGUE.md.

# Cifra el `refresh_token` de Google Calendar antes de guardarlo en la base
# (AES-256-GCM, ver src/lib/cifrado.ts). 32 bytes en base64: se genera con
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tiene que ser la MISMA cadena en local y en Vercel: si cambia, los tokens ya
# guardados dejan de poder descifrarse y hay que volver a conectar el
# calendario. Nunca debe llegar al navegador.
TOKEN_ENCRYPTION_KEY=

# No hace falta una service_role key: el token se guarda cifrado, asi que el
# privilegio de SELECT que el rol `authenticated` tiene sobre esa columna ya no
# sirve de nada -devuelve el texto cifrado-. Ver ROADMAP.md, revision de
# seguridad del 21-ago-2026.
